<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>vpn-manager-helper</AssemblyName>
    <RootNamespace>VpnManager.Helper</RootNamespace>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VpnManager.Helper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../core/src/Core/Core.csproj" />
  </ItemGroup>
</Project>
