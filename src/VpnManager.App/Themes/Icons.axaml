<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The product's symbolic glyphs, in the shared 16x16 stroked style. The
        shared set is spreadsheet-oriented; these add the tunnel verbs the toolbars
        need (connect, disconnect, refresh, edit, delete, export, import, key).
        A toolbar command names one through AppCommand.IconKey and its label moves
        to the tooltip, so the toolbar shows glyphs only.
    -->
    <StreamGeometry x:Key="WgmConnect">M8 1.5 V7 M4.3 3.9 A5.2 5.2 0 1 0 11.7 3.9</StreamGeometry>
    <StreamGeometry x:Key="WgmDisconnect">M8 1.5 V7 M4.3 3.9 A5.2 5.2 0 1 0 11.7 3.9 M2.5 2.5 L13.5 13.5</StreamGeometry>
    <StreamGeometry x:Key="WgmRefresh">M12.5 8 A4.5 4.5 0 1 1 10.6 4.3 M10.6 1.6 V4.4 H13.4</StreamGeometry>
    <StreamGeometry x:Key="WgmNew">M8 2.6 V13.4 M2.6 8 H13.4</StreamGeometry>
    <StreamGeometry x:Key="WgmEdit">M3 13 L3.6 10.2 L10.6 3.2 L12.8 5.4 L5.8 12.4 Z M9.6 4.2 L11.8 6.4</StreamGeometry>
    <StreamGeometry x:Key="WgmRename">M3 11.5 L3.6 8.7 L10.6 1.7 L12.8 3.9 L5.8 10.9 Z M9.6 2.7 L11.8 4.9 M3 14 H13</StreamGeometry>
    <StreamGeometry x:Key="WgmDelete">M3 4 H13 M6 4 V2.6 H10 V4 M4.5 4 L5.4 13.4 H10.6 L11.5 4 M6.6 6.4 V11.4 M9.4 6.4 V11.4</StreamGeometry>
    <StreamGeometry x:Key="WgmExport">M8 10 V2.6 M5.2 5.4 L8 2.6 L10.8 5.4 M3 10.5 V13.4 H13 V10.5</StreamGeometry>
    <StreamGeometry x:Key="WgmImport">M8 2.6 V10 M5.2 7.2 L8 10 L10.8 7.2 M3 11 V13.4 H13 V11</StreamGeometry>
    <StreamGeometry x:Key="WgmPolicy">M2.5 4 H13.5 M2.5 8 H13.5 M2.5 12 H13.5 M5 2.5 V5.5 M10 6.5 V9.5 M6.5 10.5 V13.5</StreamGeometry>
    <StreamGeometry x:Key="WgmKey">M6 9.5 A2.6 2.6 0 1 0 6 4.3 A2.6 2.6 0 1 0 6 9.5 M8 7 L13.4 12.4 M11.2 10.2 L12.6 11.6</StreamGeometry>
</ResourceDictionary>
